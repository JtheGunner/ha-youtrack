{
  "entity": {
    "sensor": {
      "issues_total": {
        "default": "mdi:format-list-bulleted"
      },
      "issues_open": {
        "default": "mdi:folder-open"
      },
      "issues_resolved": {
        "default": "mdi:check-circle"
      },
      "issues_unassigned": {
        "default": "mdi:account-question"
      },
      "issues_overdue": {
        "default": "mdi:calendar-alert"
      },
      "issues_created_7d": {
        "default": "mdi:plus-circle"
      },
      "issues_resolved_7d": {
        "default": "mdi:calendar-check"
      },
      "issues_critical_open": {
        "default": "mdi:alert-octagon"
      },
      "articles": {
        "default": "mdi:book-open-page-variant"
      },
      "last_updated_article": {
        "default": "mdi:book-clock"
      }
    },
    "binary_sensor": {
      "has_overdue": {
        "default": "mdi:calendar-check",
        "state": {
          "on": "mdi:calendar-alert"
        }
      },
      "has_critical_open": {
        "default": "mdi:shield-check",
        "state": {
          "on": "mdi:alert-octagon"
        }
      }
    },
    "event": {
      "issue_activity": {
        "default": "mdi:bell-ring"
      }
    },
    "todo": {
      "open_issues": {
        "default": "mdi:format-list-checks"
      }
    }
  },
  "services": {
    "create_issue": {
      "service": "mdi:plus-box"
    },
    "add_comment": {
      "service": "mdi:comment-plus"
    },
    "transition": {
      "service": "mdi:swap-horizontal"
    },
    "assign": {
      "service": "mdi:account-arrow-right"
    },
    "log_work": {
      "service": "mdi:timer-plus"
    },
    "search_articles": {
      "service": "mdi:book-search"
    },
    "get_article": {
      "service": "mdi:book-open-variant"
    }
  }
}
